{
  "name": "max-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Admin portal: dealerships, versioned script / price / knowledge-base config with approval, release gate and rollback, audit log. Every read and write goes through Postgres row-level security as the signed-in person.",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3100",
    "build": "next build --webpack",
    "start": "next start -p 3100",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "auth:migrate": "tsx --conditions=react-server scripts/auth-migrate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.87.0",
    "better-auth": "^1.7.27",
    "next": "~16.2.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "otplib": "^13.6.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
