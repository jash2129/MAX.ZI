# Copy to .env (never commit .env). Every value below is read by max_worker/server.py.

# --- required ---
DAILY_API_KEY=            # daily.co dashboard > Developers: rooms for each call
DEEPGRAM_API_KEY=         # speech-to-text (nova-3) and voice (Aura-2)
BRAIN_URL=http://localhost:8787

# --- shared secrets ---
BRAIN_TOKEN=              # same value as the brain service's BRAIN_TOKEN
WORKER_TOKEN=             # the call page's server sends this to POST /calls

# --- avatar (unset = voice-only calls) ---
HEYGEN_API_KEY=           # LiveAvatar, LITE mode
HEYGEN_AVATAR_ID=         # default: the demo's "Dexter Lawyer" avatar
HEYGEN_SANDBOX=false      # true = HeyGen sandbox session (no credits; needs a sandbox-enabled avatar)

# --- optional ---
TTS_VOICE=aura-2-arcas-en
MAX_CALLS_PER_WORKER=4
KRISP_MODEL_PATH=         # Krisp noise removal (licensed); unset = RNNoise
ENV=development           # production: missing WORKER_TOKEN fails closed
PORT=7860
